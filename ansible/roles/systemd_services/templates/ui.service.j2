[Unit]
Description=Magni EZ-Map Application & Foxglove Bridge
After=magni-navigation.service
Requires=magni-navigation.service

[Service]
Type=simple
User={{ target_user }}
Group={{ target_user }}
WorkingDirectory={{ ros2_ws }}
Environment=HOME={{ target_user_home }}
ExecStart=/usr/local/bin/magni-ros2-run.sh ezmap_backend ezmap.launch.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
